# UK dental stack: AWS Europe (London). Merge these lines into /etc/receptionist/production-uk.env
# (everything else comes from AI-receptionist-1/.env.example). deploy.sh refuses a mismatch with the
# DEPLOYMENT_REGION in production-uk.deploy.
DEPLOYMENT_REGION=eu-west-2
APP_ENV=production

# Data in London: Atlas cluster, recordings bucket and Redis all in eu-west-2.
MONGODB_URI=mongodb+srv://USER:PASSWORD@uk-cluster.REPLACE.mongodb.net/?retryWrites=true&w=majority
RECORDING_S3_REGION=eu-west-2
RECORDING_S3_BUCKET=REPLACE-receptionist-recordings-uk
REDIS_URL=redis://redis:6379/0

# Twilio: Dublin edge, IE1 region (needs API credentials created in the IE1 region).
TWILIO_EDGE=dublin
TWILIO_REGION=ie1

# LiveKit Cloud: pick the project/region closest to London.
LIVEKIT_URL=wss://REPLACE-uk.livekit.cloud

# Cliniko UK accounts are on the uk1 shard; Dentally is UK-only.
CLINIKO_SHARD=uk1
DENTALLY_API_BASE_URL=https://api.dentally.co/v1
PMS_DENTALLY_ENABLED=false

# Health data: no training, and record ZDR only once approved.
DEEPGRAM_MIP_OPT_OUT=true
OPENAI_STORE=false
OPENAI_ZDR_ENABLED=false
DEEPGRAM_ZDR_ENABLED=false
VERIFY_TWILIO_SIGNATURE=true
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY

# Voice turn-taking (see AI-receptionist-1/.env.example). v1 and adaptive need the LiveKit key pair.
VOICE_TTS_PROVIDER=deepgram
VOICE_TURN_DETECTOR=v1
VOICE_INTERRUPT_MODE=adaptive
VOICE_INTERRUPT_MIN_DURATION=0.25
VOICE_PREEMPTIVE_TTS=true
