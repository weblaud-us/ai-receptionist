# AU dental stack: AWS Asia Pacific (Sydney). Merge these lines into /etc/receptionist/production-au.env
# (everything else comes from AI-receptionist-1/.env.example). deploy.sh refuses a mismatch with the
# DEPLOYMENT_REGION in production-au.deploy.
DEPLOYMENT_REGION=ap-southeast-2
APP_ENV=production

# Data in Sydney: Atlas cluster, recordings bucket and Redis all in ap-southeast-2.
MONGODB_URI=mongodb+srv://USER:PASSWORD@au-cluster.REPLACE.mongodb.net/?retryWrites=true&w=majority
RECORDING_S3_REGION=ap-southeast-2
RECORDING_S3_BUCKET=REPLACE-receptionist-recordings-au
REDIS_URL=redis://redis:6379/0

# Twilio: Sydney edge, AU1 region (needs API credentials created in the AU1 region).
TWILIO_EDGE=sydney
TWILIO_REGION=au1

# LiveKit Cloud: pick the project/region closest to Sydney.
LIVEKIT_URL=wss://REPLACE-au.livekit.cloud

# Cliniko shard for keys without a suffix (most AU accounts: au1 or au2).
CLINIKO_SHARD=au1

# Health data: no training, and record ZDR only once approved.
DEEPGRAM_MIP_OPT_OUT=true
OPENAI_STORE=false
OPENAI_ZDR_ENABLED=false
DEEPGRAM_ZDR_ENABLED=false
VERIFY_TWILIO_SIGNATURE=true
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY

# Voice turn-taking (see AI-receptionist-1/.env.example). v1 and adaptive need the LiveKit key pair.
VOICE_TTS_PROVIDER=deepgram
VOICE_TURN_DETECTOR=v1
VOICE_INTERRUPT_MODE=adaptive
VOICE_INTERRUPT_MIN_DURATION=0.25
VOICE_PREEMPTIVE_TTS=true
