# Dev server settings for deploy/docker-compose.dev-server.yml.
#   cp deploy/dev-server.env.example deploy/dev-server.env   (gitignored), then fill it in.
# Backend secrets (Atlas MONGODB_URI, LiveKit, OpenAI, Twilio…) go in AI-receptionist-1/.env instead.

# DNS: an A record for laudline.weblaud.com and one for *.laudline.weblaud.com (or the three below), all to this server.
# Caddy gets their HTTPS certificates on first start, so ports 80 and 443 must be open.
API_DOMAIN=api.laudline.weblaud.com
APP_DOMAIN=app.laudline.weblaud.com
ADMIN_DOMAIN=admin.laudline.weblaud.com
SITE_DOMAIN=laudline.weblaud.com

# Password for the Redis container. Generate one:  openssl rand -hex 24
REDIS_PASSWORD=

# Optional. Your LiveKit project's wss:// URL, so the platform app and the landing demo may connect to it.
LIVEKIT_WSS_URL=
# Optional. Frontend error reporting.
VITE_SENTRY_DSN=
# Landing-page live demo ("Talk to Ava"): the visitor talks to the assistant in the browser. Strongly
# recommended: without it the demo section is recordings only. On only once VITE_GOOGLE_CLIENT_ID is set
# too, and the backend .env has WEB_DEMO_ENABLED=true and Google sign-in (deploy/README.md, step 5).
VITE_GOOGLE_CLIENT_ID=
VITE_WEB_DEMO=true
# Optional. Extra origins the dashboards may call, space-separated.
CSP_EXTRA_CONNECT_SRC=

# Host already has a reverse proxy on ports 80/443 (another project's nginx)? Fill these in and our
# Caddy stays off: the public services join that proxy's network, and
# `./deploy/dev-server.sh edge-setup` adds a site file to it and gets the certificate.
# Leave EDGE_NETWORK empty to use our own Caddy instead.
EDGE_NETWORK=
EDGE_PROXY=
EDGE_SITES_DIR=
EDGE_CERTBOT_CONF=
EDGE_CERTBOT_WWW=
