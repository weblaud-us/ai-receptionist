# Base URL of the AI Receptionist backend (no trailing slash)
VITE_API_URL=http://localhost:8002

# Where the two frontends live (they link to each other for the platform admin hand-off)
VITE_CLIENT_URL=http://localhost:5173
VITE_PLATFORM_URL=http://localhost:5174

# Optional: Sentry error tracking for the platform admin app (leave empty to disable)
VITE_SENTRY_DSN=
VITE_APP_ENV=development
