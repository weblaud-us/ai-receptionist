[Unit]
Description=AI Hotel Receptionist — FastAPI App
After=network.target mongod.service
Wants=mongod.service

[Service]
# ── পরিবর্তন করুন ──────────────────────────────────────────
# আপনার VPS username এবং project path দিন
User=ubuntu
WorkingDirectory=/home/ubuntu/AI-receptionist

# ── Environment file (.env থেকে সব variables load হবে) ────
EnvironmentFile=/home/ubuntu/AI-receptionist/.env

# ── Start command ───────────────────────────────────────────
ExecStart=/home/ubuntu/AI-receptionist/.venv/bin/uvicorn \
    main:app \
    --host 0.0.0.0 \
    --port 8002 \
    --workers 1 \
    --log-level info

# ── Auto-restart settings ───────────────────────────────────
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# ── Logging ─────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-receptionist

# ── Security (optional but recommended) ─────────────────────
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
