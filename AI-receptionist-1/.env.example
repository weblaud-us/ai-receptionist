# ════════════════════════════════════════════════════════════════
# AI Receptionist — environment contract
# Every variable config.py reads is listed here (CI checks this).
# Copy to .env for local development. In production, values come from
# /etc/receptionist/prod.env (or the secret manager) — never from git.
# Defaults in config.py are production-safe; production refuses to boot
# with DEBUG=true, a weak SECRET_KEY, CORS_ORIGINS=*, unsigned webhooks, etc.
# ════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────
# development | staging | production (default: production)
APP_ENV=development
# Verbose errors in API responses. Must be false outside development.
DEBUG=false
# Bind address/port for `python main.py` (systemd binds 127.0.0.1:8002 itself)
HOST=127.0.0.1
PORT=8002
# Public https URL Twilio and Meta call. Webhook signatures are computed over it.
WEBHOOK_BASE_URL=https://your-public-domain.example.com
# Short commit SHA of the running release (deploy.sh writes it to .env.release)
GIT_SHA=

# ─── MongoDB ────────────────────────────────────────────────────
# One database user per environment, readWrite on that one DB only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hotel_ai_dev

# ─── OpenAI ─────────────────────────────────────────────────────
# Project-scoped key with a monthly spend cap
OPENAI_API_KEY=sk-proj-REPLACE_ME
# Chat model for WhatsApp and the legacy voice path
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.6
# Realtime model + voice (LiveKit agent, only when LIVEKIT_USE_REALTIME=true)
OPENAI_VOICE_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=shimmer
# OpenAI TTS (LiveKit agent voice, and fallback when ElevenLabs fails)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer

# ─── Speech ─────────────────────────────────────────────────────
# STT for WhatsApp voice notes: openai_whisper
STT_PROVIDER=openai_whisper
# TTS for the legacy Twilio voice path: elevenlabs | openai
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=REPLACE_ME
# Voice used for phone calls (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Streaming STT for Phase 1 (not used yet)
DEEPGRAM_API_KEY=

# ─── Twilio voice ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Also the key Twilio signs webhooks with
TWILIO_AUTH_TOKEN=REPLACE_ME
# The business's Twilio number (E.164)
TWILIO_PHONE_NUMBER=+15555555555
# Reject webhooks without a valid X-Twilio-Signature. Must be true in production.
VERIFY_TWILIO_SIGNATURE=true
# Also check the signature on the media-stream WebSocket handshake (legacy voice path).
# If real calls are rejected after deploying, set false and report it (see twilio_auth.py).
VERIFY_TWILIO_WS_SIGNATURE=true
# Polly voice for the legacy one-way /voice/outbound message
OUTBOUND_TTS_VOICE=Polly.Joanna
# Platform SMS sender for owner alerts and caller confirmations (E.164). US: needs A2P 10DLC
# registration or a verified toll-free number, or carriers block the traffic. Empty = no SMS.
TWILIO_SMS_FROM=

# ─── Calendar integrations (Google) ─────────────────────────────
# OAuth client from Google Cloud Console (Web application). Authorised redirect URI:
#   {WEBHOOK_BASE_URL}/integrations/google/callback
# ⚠ Calendar scopes need Google app verification for production — start early. Empty = off.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypts stored OAuth refresh tokens and 2FA secrets. Required in production with Google:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate by prepending a new key: NEW,OLD (old secrets still decrypt).
TOKEN_ENCRYPTION_KEY=
# How often (minutes) busy times are pulled from connected calendars
CALENDAR_SYNC_MINUTES=10

# ─── Background jobs (API process) ──────────────────────────────
# Appointment reminders (day before + hour before), owner daily digest, calendar sync
ENABLE_TENANT_JOBS=true
TENANT_JOBS_POLL_SECONDS=300
# Business-local hour the owner's daily summary e-mail goes out
DAILY_DIGEST_HOUR=18
# Platform admins must sign in with a TOTP code. Must be true in production.
REQUIRE_ADMIN_MFA=true

# ─── Transactional e-mail (Resend) ──────────────────────────────
# Owner notifications, invites, password resets. Set up SPF/DKIM/DMARC on the sender domain first.
# Empty key = e-mails are logged, not sent (development).
RESEND_API_KEY=
EMAIL_FROM="Receptionist <hello@your-domain.example.com>"

# ─── Meta WhatsApp Cloud API ────────────────────────────────────
# Token you choose; Meta echoes it when verifying the webhook URL (random 32+ chars)
META_WA_VERIFY_TOKEN=REPLACE_ME
# System User permanent token (not a personal user token)
META_WA_ACCESS_TOKEN=REPLACE_ME
META_WA_PHONE_NUMBER_ID=REPLACE_ME
META_WABA_ID=REPLACE_ME
META_GRAPH_API_VERSION=v20.0
# App Dashboard → Settings → Basic → App Secret. Verifies X-Hub-Signature-256 on webhooks.
# Required in production when ENABLE_WHATSAPP=true.
META_APP_SECRET=REPLACE_ME

# ─── LiveKit ────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME
# Public base URL used in WhatsApp "call me" links (defaults to WEBHOOK_BASE_URL)
CALL_BASE_URL=https://your-public-domain.example.com
# Agent worker health-check port (0 = pick a free one)
LIVEKIT_WORKER_PORT=0
# true = OpenAI Realtime speech-to-speech (experiment); false = STT → LLM → TTS pipeline
LIVEKIT_USE_REALTIME=false
# Name the SIP dispatch rule and call links dispatch to (telephony/dispatch-rule.json)
LIVEKIT_AGENT_NAME=receptionist
# Warm spare worker processes so a new call never waits for one to boot (2+ in production)
LIVEKIT_NUM_IDLE_PROCESSES=1
# Outbound SIP trunk ID (ST_…) from `lk sip outbound create` — Phase 4 dialer
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# ─── Voice agent (phone + browser calls) ────────────────────────
# Fast "mini" model with reliable tool calling; benchmark with tests/evals before changing
VOICE_LLM_MODEL=gpt-4.1-mini
VOICE_LLM_TEMPERATURE=0.4
# deepgram (streaming, needs DEEPGRAM_API_KEY) | openai (fallback, slower)
VOICE_STT_PROVIDER=deepgram
VOICE_STT_MODEL=nova-3
# STT language: en-US, en-GB, es-US, ar, … or "multi" for callers who switch languages
VOICE_LANGUAGE=en-US
# elevenlabs (Flash, lowest latency) | cartesia | openai (slowest first byte — avoid for phone)
VOICE_TTS_PROVIDER=elevenlabs
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Optional fallback TTS: used automatically if the primary provider fails
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3
# Turn taking: raise MAX if callers get cut off reading numbers; lower MIN if short answers feel slow
VOICE_ENDPOINTING_MIN_DELAY=0.3
VOICE_ENDPOINTING_MAX_DELAY=2.5
# Seconds of silence before the agent asks "are you still there?"
VOICE_USER_AWAY_TIMEOUT=12
# Telephony noise cancellation on SIP calls (LiveKit Cloud BVCTelephony)
VOICE_NOISE_CANCELLATION=true
# Soft keyboard sound only while a tool runs; optional office ambience
VOICE_THINKING_SOUND=true
VOICE_AMBIENT_SOUND=false
# Staff line for transfer_to_human (E.164). Empty = no transfers, the agent takes a message
TRANSFER_PHONE_NUMBER=
# When transfers are allowed, business-local time, e.g. 09:00-21:00. Empty = any time
TRANSFER_HOURS=
# Comma-separated WhatsApp numbers told when a caller leaves a message
OWNER_NOTIFY_WHATSAPP=
# Legacy Twilio Media Streams phone path (/voice/*). Set false once numbers are on the SIP trunk
LEGACY_TWILIO_VOICE=true

# ─── Call recording (LiveKit Egress → S3-compatible storage) ────
# ⚖ Only with ENABLE_CALL_RECORDING=true; the greeting then announces recording
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
# S3-compatible endpoint (R2, MinIO, …); empty = AWS
RECORDING_S3_ENDPOINT=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_RETENTION_DAYS=30

# ─── Conversation memory ────────────────────────────────────────
# How far back a returning caller's history is loaded, and how many messages
CONVERSATION_MEMORY_DAYS=15
CONVERSATION_MEMORY_MAX_MESSAGES=20

# ─── Legacy business profile ────────────────────────────────────
# Phase 2 keeps businesses in the `tenants` collection (edit them in the dashboard). These values
# are used only until `python -m migrations.m0003_hotel_to_tenant` has turned this hotel into
# tenant #1 — then remove them.
HOTEL_NAME=Grand Palace Hotel
# Name the virtual assistant introduces itself with
RECEPTIONIST_NAME=Aria
# Human contact number given to callers
HOTEL_PHONE=+880123456789
HOTEL_ADDRESS=123 Main St, Dhaka, Bangladesh
HOTEL_CHECKIN_TIME=14:00
HOTEL_CHECKOUT_TIME=12:00
HOTEL_CURRENCY=BDT
# IANA timezone. "Today", reminders and cancellation fees use it — never the server clock.
HOTEL_TIMEZONE=Asia/Dhaka

# ─── Security ───────────────────────────────────────────────────
# Signs dashboard JWTs, call links and calendar tokens. 32+ random chars:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating it logs everyone out and invalidates calendar links.
SECRET_KEY=REPLACE_WITH_64_RANDOM_CHARS
# Optional X-Admin-Key for scripts. Empty disables it. If set: 32+ random chars.
ADMIN_SECRET_KEY=
# Bootstrap login for the platform admin before any user exists (signs in as a platform admin).
# Create real users (POST /platform/users) and then clear ADMIN_PASSWORD. Empty = disabled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOKEN_TTL_MIN=480
# Dashboard sessions: short access token + httpOnly refresh cookie (rotated on each refresh)
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Secure flag on the refresh cookie. Must be true in production; false only for http://localhost
COOKIE_SECURE=true
# lax when the dashboard and API share a site (app.x.com + api.x.com); none if on different sites
COOKIE_SAMESITE=lax
# Public dashboard URL, used in invite and password-reset links
DASHBOARD_URL=http://localhost:5173
# Browser origins allowed to call the API, comma-separated. Empty = none. Never "*" in production.
CORS_ORIGINS=http://localhost:5173

# ─── Logging / error tracking ───────────────────────────────────
# INFO in production. DEBUG logs transcripts and is refused in production.
LOG_LEVEL=INFO
# json (staging/production) | text (readable, for development)
LOG_FORMAT=text
# Sentry project DSN. Empty disables error tracking.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Feature flags ──────────────────────────────────────────────
ENABLE_VOICE_CALLS=true
ENABLE_WHATSAPP=true
ENABLE_CALL_RECORDING=false
# WhatsApp reminder one day before check-in, and how often to look for due reminders
ENABLE_ONE_DAY_BOOKING_REMINDER=true
BOOKING_REMINDER_POLL_MINUTES=30
