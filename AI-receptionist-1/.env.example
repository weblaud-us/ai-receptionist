# ════════════════════════════════════════════════════════════════
# AI Receptionist — environment contract
# Every variable config.py reads is listed here (CI checks this).
# Copy to .env for local development. In production, values come from
# /etc/receptionist/prod.env (or the secret manager) — never from git.
# Defaults in config.py are production-safe; production refuses to boot
# with DEBUG=true, a weak SECRET_KEY, CORS_ORIGINS=*, unsigned webhooks, etc.
# ════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────
# development | staging | production (default: production)
APP_ENV=development
# Verbose errors in API responses. Must be false outside development.
DEBUG=false
# Bind address/port for `python main.py` (systemd binds 127.0.0.1:8002 itself)
HOST=127.0.0.1
PORT=8002
# Public https URL Twilio and Meta call. Webhook signatures are computed over it.
WEBHOOK_BASE_URL=https://your-public-domain.example.com
# Short commit SHA of the running release (deploy.sh writes it to .env.release)
GIT_SHA=

# ─── MongoDB ────────────────────────────────────────────────────
# One database user per environment, readWrite on that one DB only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hotel_ai_dev
# Connections per process; replicas × processes × this must stay under your Atlas tier's limit.
MONGODB_MAX_POOL=50

# ─── Redis (shared state + job queue) ───────────────────────────
# Rate limits, WhatsApp dedupe, per-business call limits and the job queue, shared by every API
# replica, voice worker and jobs worker. Required in production. Empty (development) = each process
# keeps its own state and the API runs the background jobs itself (one API process only).
#   docker compose: redis://redis:6379/0   managed: rediss://default:PASSWORD@host:6380/0 (TLS)
#   Production needs a password in it (audit SRE-04): redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_URL=
# Only for the bundled Redis container in deploy/docker-compose.prod.yml (its requirepass). Same value
# as the password inside REDIS_URL.
REDIS_PASSWORD=
# Dashboard API requests one business may make per minute (0 = no limit)
API_RATE_PER_TENANT_MIN=600
# Sign-in, 2FA, password-reset and invite POSTs per IP per minute (0 = no limit). Token refresh is not counted
AUTH_RATE_PER_IP_MIN=30
# Bearer token Prometheus sends to GET /metrics. Empty = /metrics only works in development.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=
# Only on the separate host that runs fallback_app.py (Twilio trunk Disaster Recovery URL, see
# deploy/README.md). It lets that app boot without Redis. Never set it on the main API.
TELEPHONY_FALLBACK_ONLY=false

# ─── OpenAI ─────────────────────────────────────────────────────
# Project-scoped key with a monthly spend cap
OPENAI_API_KEY=sk-proj-REPLACE_ME
# Chat model for WhatsApp and the legacy voice path
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.6
# Realtime model + voice (LiveKit agent, only when LIVEKIT_USE_REALTIME=true)
OPENAI_VOICE_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=shimmer
# OpenAI TTS (LiveKit agent voice, and fallback when ElevenLabs fails)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer

# ─── Speech ─────────────────────────────────────────────────────
# STT for WhatsApp voice notes: openai_whisper
STT_PROVIDER=openai_whisper
# TTS for the legacy Twilio voice path: elevenlabs | openai
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=REPLACE_ME
# Voice used for phone calls (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Deepgram: streaming speech-to-text (Nova-3) AND the Aura voice (VOICE_TTS_PROVIDER=deepgram).
# console.deepgram.com -> API Keys. Empty = slower OpenAI speech-to-text, and no Aura voice.
DEEPGRAM_API_KEY=

# ─── Processor data use (health data: UK GDPR Art. 9, Australian Privacy Principles) ───
# Opt every Deepgram request out of its Model Improvement Program (no training on call audio).
DEEPGRAM_MIP_OPT_OUT=true
# Never let OpenAI store completions (the `store` flag; used for evals/distillation on their side).
OPENAI_STORE=false
# true ONLY after the vendor has approved Zero Data Retention for this account (a contract, not a
# code switch). The DPA and SUBPROCESSORS pages describe ZDR only when these are true.
OPENAI_ZDR_ENABLED=false
DEEPGRAM_ZDR_ENABLED=false

# ─── Regional deployment (AU / UK dental stacks: deploy/README.md → "Regional stacks") ───
# Where this stack keeps its data: ap-southeast-2 (Sydney, AU practices) | eu-west-2 (London, UK practices)
DEPLOYMENT_REGION=
# Twilio edge / region: sydney + au1 for AU, dublin + ie1 for UK. Empty = api.twilio.com (US).
# ⚠ A non-US Twilio region needs API credentials created in that region.
TWILIO_EDGE=
TWILIO_REGION=

# ─── Dental practice-management systems ─────────────────────────────────
# Cliniko (AU): required User-Agent with your app name and a contact e-mail.
CLINIKO_USER_AGENT=
# Shard for Cliniko keys without a -au1 / -au2 / -uk1 suffix: au1 | au2 | uk1
CLINIKO_SHARD=au1
# Dentally (UK): needs an approved partner application. Keep false until verified against the sandbox.
PMS_DENTALLY_ENABLED=false
DENTALLY_API_BASE_URL=https://api.dentally.co/v1

# ─── Twilio voice ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Also the key Twilio signs webhooks with
TWILIO_AUTH_TOKEN=REPLACE_ME
# The business's Twilio number (E.164)
TWILIO_PHONE_NUMBER=+15555555555
# Reject webhooks without a valid X-Twilio-Signature. Must be true in production.
VERIFY_TWILIO_SIGNATURE=true
# Also check the signature on the media-stream WebSocket handshake (legacy voice path).
# If real calls are rejected after deploying, set false and report it (see twilio_auth.py).
VERIFY_TWILIO_WS_SIGNATURE=true
# Polly voice for the legacy one-way /voice/outbound message
OUTBOUND_TTS_VOICE=Polly.Joanna
# Platform SMS sender for owner alerts and caller confirmations (E.164). US: needs A2P 10DLC
# registration or a verified toll-free number, or carriers block the traffic. Empty = no SMS.
TWILIO_SMS_FROM=

# ─── Calendar integrations (Google) ─────────────────────────────
# OAuth client from Google Cloud Console (Web application). Authorised redirect URI:
#   {WEBHOOK_BASE_URL}/integrations/google/callback
# ⚠ Calendar scopes need Google app verification for production — start early. Empty = off.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypts stored OAuth refresh tokens and 2FA secrets. Required in production with Google:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate by prepending a new key: NEW,OLD (old secrets still decrypt).
TOKEN_ENCRYPTION_KEY=
# How often (minutes) busy times are pulled from connected calendars
CALENDAR_SYNC_MINUTES=10

# ─── Background jobs (API process) ──────────────────────────────
# Appointment reminders (day before + hour before), owner daily digest, calendar sync
ENABLE_TENANT_JOBS=true
TENANT_JOBS_POLL_SECONDS=300
# Business-local hour the owner's daily summary e-mail goes out
DAILY_DIGEST_HOUR=18
# Platform admins must sign in with a TOTP code. Must be true in production.
REQUIRE_ADMIN_MFA=true

# ─── Transactional e-mail (Resend) ──────────────────────────────
# Owner notifications, invites, password resets. Set up SPF/DKIM/DMARC on the sender domain first.
# Empty key = e-mails are logged, not sent (development).
RESEND_API_KEY=
EMAIL_FROM="Receptionist <hello@your-domain.example.com>"

# ─── Meta WhatsApp Cloud API ────────────────────────────────────
# Token you choose; Meta echoes it when verifying the webhook URL (random 32+ chars)
META_WA_VERIFY_TOKEN=REPLACE_ME
# System User permanent token (not a personal user token)
META_WA_ACCESS_TOKEN=REPLACE_ME
META_WA_PHONE_NUMBER_ID=REPLACE_ME
META_WABA_ID=REPLACE_ME
META_GRAPH_API_VERSION=v20.0
# App Dashboard → Settings → Basic → App Secret. Verifies X-Hub-Signature-256 on webhooks.
# Required in production when ENABLE_WHATSAPP=true.
META_APP_SECRET=REPLACE_ME

# ─── LiveKit ────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME
# Public base URL used in WhatsApp "call me" links (defaults to WEBHOOK_BASE_URL)
CALL_BASE_URL=https://your-public-domain.example.com
# Agent worker health-check port (0 = pick a free one)
LIVEKIT_WORKER_PORT=0
# true = OpenAI Realtime speech-to-speech (experiment); false = STT → LLM → TTS pipeline
LIVEKIT_USE_REALTIME=false
# Name the SIP dispatch rule and call links dispatch to (telephony/dispatch-rule.json)
LIVEKIT_AGENT_NAME=receptionist
# Warm spare worker processes so a new call never waits for one to boot (2+ in production)
LIVEKIT_NUM_IDLE_PROCESSES=1
# Outbound SIP trunk ID (ST_…) from `lk sip outbound create` — transfers and synthetic calls
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# ─── Outbound AI sales dialer (Phase 4) — docs/PHASE_4_TESTING.md ─
# ⚖ Have a telemarketing lawyer review the call type, opener and lead list before the first call.
# Master switch. false = nothing is ever dialled, whatever the dashboard says.
OUTBOUND_DIALER_ENABLED=false
# The sales worker registers under this name (python -m agent.sales_worker)
SALES_AGENT_NAME=sales-caller
# Your own business as a tenant (ten_…): its voice, opening hours, calendar and a service called
# SALES_DEMO_SERVICE (15 min) that demos are booked as. Its transfer number is "transfer to founder".
SALES_TENANT_ID=
# A SIP trunk used ONLY for sales calls, on its own Twilio subaccount. Required in production, and
# it must differ from LIVEKIT_SIP_OUTBOUND_TRUNK_ID: a complaint must never touch customers' calls.
SALES_SIP_OUTBOUND_TRUNK_ID=
SALES_COMPANY_NAME=WEBLAUD
SALES_PERSONA_NAME=Max
SALES_FOUNDER_NAME=
SALES_DEMO_SERVICE=Demo
SALES_DEMO_MEETING_URL=
# Public demo number; also the callback number left on (consented) voicemails
SALES_DEMO_LINE=
# Postal address + how to opt out: required on commercial e-mail (CAN-SPAM)
SALES_EMAIL_FOOTER=
SALES_MAX_CALL_MINUTES=10
SALES_RING_TIMEOUT_S=25
# Calls per caller ID per 24 h. Start at 20-30 and raise slowly; watch answer rates.
SALES_MAX_CALLS_PER_NUMBER_PER_DAY=30
SALES_COST_PER_MINUTE_USD=0.10
# Line-type lookups (Twilio Lookup v2, paid per lookup). Empty = TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN
TWILIO_LOOKUP_ACCOUNT_SID=
TWILIO_LOOKUP_AUTH_TOKEN=
SALES_LINE_TYPE_MAX_AGE_DAYS=15
# A national / state do-not-call list older than this blocks dialling (scripts/import_dnc_registry.py)
SALES_DNC_REGISTRY_MAX_AGE_DAYS=31
# US states where AI cold calls stay off until counsel clears each one (mini-TCPA states)
SALES_BLOCKED_US_STATES=FL,OK,MD,WA
# Countries where a written consent record is enough for an AI call / where live B2B calls are allowed
SALES_AI_CONSENTED_COUNTRIES=US
SALES_HUMAN_ASSISTED_COUNTRIES=US,CA,GB
# "Get a call from our AI" form: id of the running ai_consented campaign new sign-ups join
SALES_CONSENT_CAMPAIGN_ID=
PUBLIC_DEMO_CALL_PER_IP_HOUR=3
PUBLIC_DEMO_CALL_MAX_PER_DAY=200
# Deploys without dropped calls: on SIGTERM the worker stops taking calls and waits this many
# seconds for live ones. The container's stop grace period must be longer (16m in the compose file).
LIVEKIT_DRAIN_TIMEOUT=900
# CPU load (0–1) above which a worker refuses new calls so LiveKit sends them to another worker
# (`start` mode only; `dev` never refuses)
LIVEKIT_LOAD_THRESHOLD=0.7
# Memory per call process: warn above WARN, kill that one call's process above LIMIT (0 = never)
LIVEKIT_JOB_MEMORY_WARN_MB=700
LIVEKIT_JOB_MEMORY_LIMIT_MB=2000
# Port for the worker's own Prometheus metrics (LiveKit process stats). 0 = off
LIVEKIT_PROMETHEUS_PORT=0

# ─── Billing and self-serve signup (Phase 5) — docs/PHASE_5_TESTING.md ─
# Empty STRIPE_SECRET_KEY = billing off (development): sign-ups get a local trial, nothing is charged.
# Production refuses SIGNUP_ENABLED=true without Stripe keys, the webhook secret, a plan price and e-mail.
STRIPE_SECRET_KEY=                   # sk_test_… while testing; a restricted key with Checkout/Customers/Subscriptions/Meter events
STRIPE_WEBHOOK_SECRET=               # whsec_… from the endpoint https://<api>/billing/stripe/webhook
STRIPE_PRICE_STARTER_MONTHLY=        # price_… ($69/month)
STRIPE_PRICE_STARTER_ANNUAL=         # price_… ($690/year)
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_OVERAGE=                # metered price ($0.25/unit) on the Billing Meter below
STRIPE_METER_EVENT_NAME=overage_minutes
STRIPE_PRICE_SETUP_FEE=              # optional one-off $149 "done-for-you setup"
# Dental plans (AU/UK practices): retainers with AUD + GBP currency_options, and their mandatory one-time
# onboarding fees (amounts in core/billing/plans.py PRICE_BOOK / DENTAL_SETUP_FEES — set your own first).
# A dental plan is offered only once its monthly Price AND its setup Price are set.
STRIPE_PRICE_DENTAL_ESSENTIALS_MONTHLY=
STRIPE_PRICE_DENTAL_ESSENTIALS_ANNUAL=
STRIPE_PRICE_DENTAL_PRO_MONTHLY=
STRIPE_PRICE_DENTAL_PRO_ANNUAL=
STRIPE_PRICE_DENTAL_SETUP_ESSENTIALS=
STRIPE_PRICE_DENTAL_SETUP_PRO=
STRIPE_AUTOMATIC_TAX=true            # Stripe Tax (register in each place you must collect first)
SIGNUP_ENABLED=false
SIGNUP_RATE_PER_IP_HOUR=5
TRIAL_DAYS=14
TRIAL_MINUTES=50                     # hard cap during the trial
PAST_DUE_SUSPEND_DAYS=7              # unpaid this long → assistant paused, calls forwarded
CANCEL_RETENTION_DAYS=30             # data kept after cancelling, then deleted
TERMS_URL=
PRIVACY_URL=

# ─── Legal and compliance (Phase 6) — docs/PHASE_6_TESTING.md, docs/COMPLIANCE.md ─
# Public URLs of the published documents (drafts: docs/legal/). Production refuses SIGNUP_ENABLED=true
# without TERMS_URL, PRIVACY_URL and DPA_URL. Versions live in core/compliance/legal.py.
DPA_URL=
AUP_URL=
SLA_URL=
SECURITY_URL=
SUBPROCESSORS_URL=
LEGAL_ENTITY_NAME=WEBLAUD LLC
# Where data-protection requests go (shown in the dashboard and privacy policy)
PRIVACY_CONTACT_EMAIL=
# Due date shown on each data subject request (GDPR: one month)
DSR_DEADLINE_DAYS=30
# Reply to STOP / START / HELP texts (POST /telephony/sms/inbound). false if a Twilio Messaging
# Service with Advanced Opt-Out already replies.
SMS_OPTOUT_REPLY=true

# ─── Launch, pilots and support (Phase 7) — docs/PHASE_7_TESTING.md ─
# The live demo line for the website (GET /public/site)
DEMO_PHONE_NUMBER=
# Hosted status page, outside this server (Better Stack, Instatus…)
STATUS_PAGE_URL=
SUPPORT_EMAIL=
HELP_CENTER_URL=
# "Your assistant this month" e-mail on the 1st, and the hour (business-local) reports go out
MONTHLY_REPORT_ENABLED=true
REPORT_HOUR=9
# You, in copy of every weekly pilot report
PILOT_REPORT_BCC=
# Share of non-pilot calls in the transcript review queue (pilots: every call)
REVIEW_SAMPLE_PCT=20

# ─── Number provisioning (Phase 5) ──────────────────────────────
# Buy (or connect a number already in your Twilio account) → Twilio Elastic SIP trunk → LiveKit inbound
# trunk → routing table → test call. Powers the platform's New business wizard and each business's
# "Add number", so you never run setup_telephony by hand for a new number.
# TELEPHONY_PROVIDER=softphone (development): fake +1555 numbers, mapping only.
NUMBER_PROVISIONING_ENABLED=false
TWILIO_SIP_TRUNK_SID=                # TK… Twilio → Elastic SIP Trunking → your trunk → Trunk SID
LIVEKIT_SIP_INBOUND_TRUNK_ID=        # ST_… inbound trunk (scripts/setup_telephony.py prints it)
NUMBER_INSTANT_COUNTRIES=US,CA       # elsewhere: regulatory bundle first, order waits for approval
NUMBER_VERIFY_CALL=true              # dial the new number via LIVEKIT_SIP_OUTBOUND_TRUNK_ID before marking it active
TRANSFER_BLOCKED_PREFIXES=+1900,+1976,+449,+4487,+44118,+4470,+35315,+35650,+61190,+3389,+3381,+3382,+49900,+49137,+43900,+43930,+43939,+34803,+34806,+34807,+34905,+39899,+39892,+31906,+31909,+32900,+32902,+32903,+32904,+32905,+32906,+32907,+32909,+971900,+870,+881,+882,+883,+979   # ⚠ verify per market (premium, revenue-share, satellite)

# ─── Voice agent (phone + browser calls) ────────────────────────
# Fast "mini" model with reliable tool calling; benchmark with tests/evals before changing
VOICE_LLM_MODEL=gpt-4.1-mini
VOICE_LLM_TEMPERATURE=0.4
# Fallback LLM on a second provider, used automatically when OpenAI fails or has not started
# answering within 6 s. Empty key = no fallback. Benchmark it with tests/evals before relying on it.
ANTHROPIC_API_KEY=
VOICE_LLM_FALLBACK_MODEL=claude-haiku-5-5
# OpenAI speech-to-text behind Deepgram when Deepgram fails (needs OPENAI_API_KEY)
VOICE_STT_FALLBACK=true
# deepgram (streaming, needs DEEPGRAM_API_KEY) | openai (fallback, slower)
VOICE_STT_PROVIDER=deepgram
VOICE_STT_MODEL=nova-3
# STT language: en-US, en-GB, es-US, ar, … or "multi" for callers who switch languages
VOICE_LANGUAGE=en-US
# The agent's voice. Tried in this order: VOICE_TTS_PROVIDER, then VOICE_TTS_FALLBACKS (left to right).
# A voice with no key / URL is skipped; if one fails during a call the next takes over.
#   deepgram    Aura-2, needs DEEPGRAM_API_KEY. Fast, generous free credit
#   kokoro      local Kokoro-82M (free, no account), needs KOKORO_BASE_URL and the Docker container
#   elevenlabs  Flash, lowest latency, needs ELEVENLABS_API_KEY
#   cartesia    needs CARTESIA_API_KEY
#   openai      uses OPENAI_API_KEY; slowest first sound, avoid as the first choice for phone
# A business's own voice setting goes first (new AU / UK dental practices start on Deepgram Aura in a
# local accent); a provider without a key is skipped.
VOICE_TTS_PROVIDER=deepgram
VOICE_TTS_FALLBACKS=deepgram,cartesia,elevenlabs,kokoro,openai
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Deepgram Aura voice (the model name is the voice), e.g. aura-2-andromeda-en, aura-2-luna-en, aura-2-orion-en
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en
# Local Kokoro-82M: docker compose -f docker-compose.dev.yml --profile local-tts up -d kokoro
# http://kokoro:8880/v1 from the worker container; http://localhost:8880/v1 if the worker runs on your PC.
# Empty = Kokoro off. Voices: af_heart, af_bella, af_sky, am_adam, ...
KOKORO_BASE_URL=
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_heart
# Optional fallback TTS: used automatically if the primary provider fails
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3
# Turn taking. v1 = LiveKit's cloud end-of-turn model (local v1-mini as a fallback); adaptive = barge-in
# that stops for "wait"/"no" but talks through the caller's "mm-hmm". Both use LIVEKIT_API_KEY/SECRET.
VOICE_TURN_DETECTOR=v1
VOICE_INTERRUPT_MODE=adaptive
VOICE_INTERRUPT_MIN_DURATION=0.25
# Start the voice before the turn is confirmed (saves one TTS first-byte delay per reply)
VOICE_PREEMPTIVE_TTS=true
# Raise MAX if callers get cut off; the agent already waits longer right after it asks for digits
VOICE_ENDPOINTING_MIN_DELAY=0.3
VOICE_ENDPOINTING_MAX_DELAY=2.5
# Seconds of silence before the agent asks "are you still there?"
VOICE_USER_AWAY_TIMEOUT=12
# Telephony noise cancellation on SIP calls (LiveKit Cloud BVCTelephony)
VOICE_NOISE_CANCELLATION=true
# Soft keyboard sound only while a tool runs; optional office ambience
VOICE_THINKING_SOUND=true
VOICE_AMBIENT_SOUND=false
# Staff line for transfer_to_human (E.164). Empty = no transfers, the agent takes a message
TRANSFER_PHONE_NUMBER=
# When transfers are allowed, business-local time, e.g. 09:00-21:00. Empty = any time
TRANSFER_HOURS=
# Comma-separated WhatsApp numbers told when a caller leaves a message
OWNER_NOTIFY_WHATSAPP=
# Legacy Twilio Media Streams phone path (/voice/*). Set false once numbers are on the SIP trunk
LEGACY_TWILIO_VOICE=false

# ─── Telephony (SIP into LiveKit) ───────────────────────────────
# APP_ENV picks the phone provider (docs/TELEPHONY_TESTING.md):
#   development         → softphone: Linphone dials LiveKit SIP directly. Free, no Twilio account.
#   staging/production  → twilio:    Twilio Elastic SIP Trunking.
# Leave empty to follow APP_ENV. Other values:
#   livekit  a US phone number rented in LiveKit Cloud (Telephony → Phone Numbers). No Twilio, no trunk,
#            works in any APP_ENV. `setup_telephony` then creates only the dispatch rule you assign to it.
#   twilio   try Twilio from a dev machine
# Production refuses to boot with "softphone".
TELEPHONY_PROVIDER=
# Create the LiveKit trunks and dispatch rule for the active provider (idempotent):
#   uv run python -m scripts.setup_telephony [--dry-run] [--assign TENANT_ID]

# softphone (APP_ENV=development) ──
# Comma-separated fake numbers you "dial" from Linphone. The business is found from the dialled number.
SOFTPHONE_TEST_NUMBERS=+15550000001
# Credentials the trunk asks Linphone for. The username doubles as the fake caller number.
SOFTPHONE_SIP_USERNAME=15557654321
SOFTPHONE_SIP_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# twilio (APP_ENV=staging/production) ──
# Credentials Twilio presents to the LiveKit inbound trunk. Empty = Twilio sends none, so the
# trunk accepts calls by number only (see telephony/README.md).
TWILIO_SIP_INBOUND_USERNAME=
TWILIO_SIP_INBOUND_PASSWORD=
# Twilio trunk termination URI (Termination → Termination SIP URI), used for transfers and outbound
TWILIO_TERMINATION_URI=yourname.pstn.twilio.com
# Twilio trunk credential list (Termination → Credential Lists) the outbound trunk logs in with
TWILIO_SIP_OUTBOUND_USERNAME=
TWILIO_SIP_OUTBOUND_PASSWORD=

# ─── Permanent call link (browser) ──────────────────────────────
# /talk/<business>?k=<key> never expires. Print it with:
#   uv run python -m scripts.call_link --base https://your-public-url
# Anyone holding it can start a call, so it is rate limited. Raise CALL_LINK_VERSION to turn every
# permanent link off at once (then print the new link).
CALL_LINK_VERSION=1
# Calls one visitor can start per hour, and all visitors together per day (permanent links only)
PUBLIC_CALL_RATE_PER_IP_HOUR=10
PUBLIC_CALL_MAX_PER_DAY=100
# Only for the ngrok tunnel (docker compose --profile public-ngrok): your ngrok account's authtoken.
# Not read by the app. Leave it out if you use the Cloudflare quick tunnel.
# NGROK_AUTHTOKEN=

# ─── Old call recordings (S3-compatible storage) ────────────────
# Calls are no longer recorded. These are only used to delete audio recorded before that change
# (retention purge and offboarding). Leave empty if this deployment never recorded calls.
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
# S3-compatible endpoint (R2, MinIO, …); empty = AWS
RECORDING_S3_ENDPOINT=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_RETENTION_DAYS=30

# ─── Conversation memory ────────────────────────────────────────
# How far back a returning caller's history is loaded, and how many messages
CONVERSATION_MEMORY_DAYS=15
CONVERSATION_MEMORY_MAX_MESSAGES=20

# ─── Legacy business profile ────────────────────────────────────
# Phase 2 keeps businesses in the `tenants` collection (edit them in the dashboard). These values
# are used only until `python -m migrations.m0003_hotel_to_tenant` has turned this hotel into
# tenant #1 — then remove them.
HOTEL_NAME=Grand Palace Hotel
# Name the virtual assistant introduces itself with
RECEPTIONIST_NAME=Aria
# Human contact number given to callers
HOTEL_PHONE=+880123456789
HOTEL_ADDRESS=123 Main St, Dhaka, Bangladesh
HOTEL_CHECKIN_TIME=14:00
HOTEL_CHECKOUT_TIME=12:00
HOTEL_CURRENCY=BDT
# IANA timezone. "Today", reminders and cancellation fees use it — never the server clock.
HOTEL_TIMEZONE=Asia/Dhaka

# ─── Security ───────────────────────────────────────────────────
# Signs dashboard JWTs, call links and calendar tokens. 32+ random chars:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating it logs everyone out and invalidates calendar links.
SECRET_KEY=REPLACE_WITH_64_RANDOM_CHARS
# Cloudflare (proxied) in front of the API? Then the visitor's address comes from CF-Connecting-IP.
# Only set true when the origin firewall accepts Cloudflare's IP ranges alone.
BEHIND_CLOUDFLARE=false
# Optional X-Admin-Key for scripts. Empty disables it. If set: 32+ random chars.
ADMIN_SECRET_KEY=
# Bootstrap login for the platform admin before any user exists (signs in as a platform admin).
# Create real users (POST /platform/users) and then clear ADMIN_PASSWORD. Empty = disabled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOKEN_TTL_MIN=480
# Dashboard sessions: short access token + httpOnly refresh cookie (rotated on each refresh)
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Secure flag on the refresh cookie. Must be true in production; false only for http://localhost
COOKIE_SECURE=true
# lax when the dashboard and API share a site (app.x.com + api.x.com); none if on different sites
COOKIE_SAMESITE=lax
# Public dashboard URL, used in invite and password-reset links
DASHBOARD_URL=http://localhost:5173
# Browser origins allowed to call the API, comma-separated. Empty = none. Never "*" in production.
# (local: the client dashboard and the platform admin app)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Logging / error tracking ───────────────────────────────────
# INFO in production. DEBUG logs transcripts and is refused in production.
LOG_LEVEL=INFO
# json (staging/production) | text (readable, for development)
LOG_FORMAT=text
# Sentry project DSN. Empty disables error tracking.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Feature flags ──────────────────────────────────────────────
ENABLE_VOICE_CALLS=true
ENABLE_WHATSAPP=true
# The platform sends no SMS: patient messages go by WhatsApp or email, owner alerts by e-mail/WhatsApp,
# and transfer numbers are verified by a phone call. Keep false.
SMS_ENABLED=false
# WhatsApp reminder one day before check-in, and how often to look for due reminders
ENABLE_ONE_DAY_BOOKING_REMINDER=true
BOOKING_REMINDER_POLL_MINUTES=30
