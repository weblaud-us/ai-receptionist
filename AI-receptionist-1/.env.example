# ════════════════════════════════════════════════════════════════
# AI Receptionist — environment contract
# Every variable config.py reads is listed here (CI checks this).
# Copy to .env for local development. In production, values come from
# /etc/receptionist/prod.env (or the secret manager) — never from git.
# Defaults in config.py are production-safe; production refuses to boot
# with DEBUG=true, a weak SECRET_KEY, CORS_ORIGINS=*, unsigned webhooks, etc.
# ════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────
# development | staging | production (default: production)
APP_ENV=development
# Verbose errors in API responses. Must be false outside development.
DEBUG=false
# Bind address/port for `python main.py` (systemd binds 127.0.0.1:8002 itself)
HOST=127.0.0.1
PORT=8002
# Public https URL Twilio and Meta call. Webhook signatures are computed over it.
WEBHOOK_BASE_URL=https://your-public-domain.example.com
# Short commit SHA of the running release (deploy.sh writes it to .env.release)
GIT_SHA=

# ─── MongoDB ────────────────────────────────────────────────────
# One database user per environment, readWrite on that one DB only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hotel_ai_dev

# ─── OpenAI ─────────────────────────────────────────────────────
# Project-scoped key with a monthly spend cap
OPENAI_API_KEY=sk-proj-REPLACE_ME
# Chat model for WhatsApp and the legacy voice path
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.6
# Realtime model + voice (LiveKit agent, only when LIVEKIT_USE_REALTIME=true)
OPENAI_VOICE_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=shimmer
# OpenAI TTS (LiveKit agent voice, and fallback when ElevenLabs fails)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer

# ─── Speech ─────────────────────────────────────────────────────
# STT for WhatsApp voice notes: openai_whisper
STT_PROVIDER=openai_whisper
# TTS for the legacy Twilio voice path: elevenlabs | openai
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=REPLACE_ME
# Voice used for phone calls (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Streaming STT for Phase 1 (not used yet)
DEEPGRAM_API_KEY=

# ─── Twilio voice ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Also the key Twilio signs webhooks with
TWILIO_AUTH_TOKEN=REPLACE_ME
# The business's Twilio number (E.164)
TWILIO_PHONE_NUMBER=+15555555555
# Reject webhooks without a valid X-Twilio-Signature. Must be true in production.
VERIFY_TWILIO_SIGNATURE=true
# Also check the signature on the media-stream WebSocket handshake (legacy voice path).
# If real calls are rejected after deploying, set false and report it (see twilio_auth.py).
VERIFY_TWILIO_WS_SIGNATURE=true
# Polly voice for the legacy one-way /voice/outbound message
OUTBOUND_TTS_VOICE=Polly.Joanna

# ─── Meta WhatsApp Cloud API ────────────────────────────────────
# Token you choose; Meta echoes it when verifying the webhook URL (random 32+ chars)
META_WA_VERIFY_TOKEN=REPLACE_ME
# System User permanent token (not a personal user token)
META_WA_ACCESS_TOKEN=REPLACE_ME
META_WA_PHONE_NUMBER_ID=REPLACE_ME
META_WABA_ID=REPLACE_ME
META_GRAPH_API_VERSION=v20.0
# App Dashboard → Settings → Basic → App Secret. Verifies X-Hub-Signature-256 on webhooks.
# Required in production when ENABLE_WHATSAPP=true.
META_APP_SECRET=REPLACE_ME

# ─── LiveKit ────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME
# Public base URL used in WhatsApp "call me" links (defaults to WEBHOOK_BASE_URL)
CALL_BASE_URL=https://your-public-domain.example.com
# Agent worker health-check port (0 = pick a free one)
LIVEKIT_WORKER_PORT=0
# true = OpenAI Realtime speech-to-speech; false = STT → LLM → TTS pipeline
LIVEKIT_USE_REALTIME=false

# ─── Conversation memory ────────────────────────────────────────
# How far back a returning caller's history is loaded, and how many messages
CONVERSATION_MEMORY_DAYS=15
CONVERSATION_MEMORY_MAX_MESSAGES=20

# ─── Business profile (moves to the tenants collection in Phase 2) ──
HOTEL_NAME=Grand Palace Hotel
# Name the virtual assistant introduces itself with
RECEPTIONIST_NAME=Aria
# Human contact number given to callers
HOTEL_PHONE=+880123456789
HOTEL_ADDRESS=123 Main St, Dhaka, Bangladesh
HOTEL_CHECKIN_TIME=14:00
HOTEL_CHECKOUT_TIME=12:00
HOTEL_CURRENCY=BDT
# IANA timezone. "Today", reminders and cancellation fees use it — never the server clock.
HOTEL_TIMEZONE=Asia/Dhaka

# ─── Security ───────────────────────────────────────────────────
# Signs dashboard JWTs, call links and calendar tokens. 32+ random chars:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating it logs everyone out and invalidates calendar links.
SECRET_KEY=REPLACE_WITH_64_RANDOM_CHARS
# Optional X-Admin-Key for scripts. Empty disables it. If set: 32+ random chars.
ADMIN_SECRET_KEY=
# Dashboard login (until Phase 2 adds real users). Empty password = login disabled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOKEN_TTL_MIN=480
# Browser origins allowed to call the API, comma-separated. Empty = none. Never "*" in production.
CORS_ORIGINS=http://localhost:5173

# ─── Logging / error tracking ───────────────────────────────────
# INFO in production. DEBUG logs transcripts and is refused in production.
LOG_LEVEL=INFO
# json (staging/production) | text (readable, for development)
LOG_FORMAT=text
# Sentry project DSN. Empty disables error tracking.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Feature flags ──────────────────────────────────────────────
ENABLE_VOICE_CALLS=true
ENABLE_WHATSAPP=true
ENABLE_CALL_RECORDING=false
# WhatsApp reminder one day before check-in, and how often to look for due reminders
ENABLE_ONE_DAY_BOOKING_REMINDER=true
BOOKING_REMINDER_POLL_MINUTES=30
