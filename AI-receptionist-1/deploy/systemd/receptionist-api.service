# /etc/systemd/system/receptionist-api.service — FastAPI (webhooks, dashboard API, browser-call page)
[Unit]
Description=Receptionist API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=receptionist
Group=receptionist
WorkingDirectory=/opt/receptionist/AI-receptionist-1
# Secrets: one file per environment, readable only by root and this user (chmod 640).
EnvironmentFile=/etc/receptionist/prod.env
# Written by deploy.sh (GIT_SHA for Sentry releases). The leading "-" makes it optional.
EnvironmentFile=-/opt/receptionist/AI-receptionist-1/.env.release
# Bind to localhost only — Nginx terminates TLS and proxies to it.
# --proxy-headers + --forwarded-allow-ips: trust X-Forwarded-For from Nginx only, so the
# login rate limiter sees real client IPs instead of 127.0.0.1.
# One worker: call state is in memory until Phase 3 moves it to Redis.
ExecStart=/opt/receptionist/AI-receptionist-1/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 --port 8002 --workers 1 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1 \
    --no-server-header
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
# /usr, /boot, /etc read-only. (Not ProtectHome: uv may keep its Python under ~receptionist.)
ProtectSystem=full

[Install]
WantedBy=multi-user.target
