# ════════════════════════════════════════════════════════════════
# Hotel AI Receptionist — Environment Configuration
# Copy this to .env and fill in your actual values
# ════════════════════════════════════════════════════════════════

# ─── Application Core ───────────────────────────────────────────
APP_NAME=Hotel AI Receptionist
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8002
HOTEL_NAME=Grand Palace Hotel
RECEPTIONIST_NAME=Aria
HOTEL_ADDRESS=123 Main St, Dhaka, Bangladesh
HOTEL_PHONE=+880123456789
HOTEL_CHECKIN_TIME=14:00
HOTEL_CHECKOUT_TIME=11:00
HOTEL_CURRENCY=BDT
HOTEL_TIMEZONE=Asia/Dhaka

# ─── Database (MongoDB) ─────────────────────────────────────────
# Cloud: MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hotel_ai

# Alternative: Local MongoDB
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=hotel_ai

# ─── LLM Provider ───────────────────────────────────────────────
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.6
OPENAI_VOICE_MODEL=gpt-realtime-2025-08-28
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# For single-voice across LiveKit Realtime + Twilio TTS, use one of: alloy | echo | shimmer
VOICE_NAME=shimmer
OPENAI_REALTIME_VOICE=shimmer
OPENAI_TTS_VOICE=shimmer

# ─── Speech-to-Text (STT) ───────────────────────────────────────
STT_PROVIDER=openai_whisper

# ─── Text-to-Speech (TTS) ───────────────────────────────────────
TTS_PROVIDER=elevenlabs

# ElevenLabs TTS (high quality voice)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel voice

# ─── Twilio ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1555555555
TWILIO_WHATSAPP_NUMBER=whatsapp:+1555555555
WHATSAPP_MAX_PARTS=1

# Twilio Webhook Security
VERIFY_TWILIO_SIGNATURE=false  # Set to true in production

# Meta WhatsApp Cloud API
META_WA_VERIFY_TOKEN=your_verify_token_here
META_WA_ACCESS_TOKEN=your_access_token_here
META_WA_PHONE_NUMBER_ID=your_phone_number_id_here
META_WABA_ID=your_waba_id_here
META_GRAPH_API_VERSION=v20.0

# Conversation memory
CONVERSATION_MEMORY_DAYS=15
CONVERSATION_MEMORY_MAX_MESSAGES=20

# LiveKit
LIVEKIT_URL=wss://your-livekit-domain
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
LIVEKIT_WORKER_PORT=0
CALL_BASE_URL=https://your-public-domain
LIVEKIT_USE_REALTIME=false

# ─── Webhooks & Networking ──────────────────────────────────────
# For local development with ngrok
WEBHOOK_BASE_URL=https://your-ngrok-url.io
WEBHOOK_TIMEOUT_SECONDS=30

# ─── Admin & Security ───────────────────────────────────────────
ADMIN_SECRET_KEY=your-super-secret-admin-key-change-this
API_KEY_REQUIRED=false  # Set true to require API key for admin routes
SECRET_KEY=replace-with-a-strong-random-secret
WEBHOOK_SECRET=replace-with-a-strong-random-secret

# Dashboard login (JWT signed with SECRET_KEY). Login is disabled while ADMIN_PASSWORD is empty
# or SECRET_KEY is left at its default.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOKEN_TTL_MIN=480
# Browser origins allowed to call the API (comma-separated), e.g. https://dashboard.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ─── Logging ────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FILE=hotel_ai.log
LOG_MAX_SIZE_MB=50
LOG_BACKUP_COUNT=5

# ─── Feature Flags ──────────────────────────────────────────────
ENABLE_VOICE_CALLS=true
ENABLE_WHATSAPP=true
ENABLE_BOOKING_CONFIRMATION_SMS=false
ENABLE_CALL_RECORDING=false
ENABLE_ONE_DAY_BOOKING_REMINDER=true
BOOKING_REMINDER_POLL_MINUTES=30
