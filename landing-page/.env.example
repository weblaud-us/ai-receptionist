# Landing page settings. Copy to .env for local builds; in Docker pass them as --build-arg.
# All values are baked into the static HTML at build time, so build once per environment.

# Public origin of this site (canonical URLs, Open Graph, sitemap, robots.txt). No trailing slash.
VITE_SITE_URL=https://www.example.com

# Client dashboard. CTAs add ?vertical=dental&country=AU|GB&plan=dental_essentials|dental_pro.
VITE_DASHBOARD_SIGNUP_URL=https://app.example.com/signup
VITE_DASHBOARD_LOGIN_URL=https://app.example.com/login

# Browser test-call page (e.g. a dental-branded copy of AI-receptionist-1/ui/call.html).
# Empty hides the "Call from your browser" button.
VITE_DEMO_CALL_URL=
# Calendar link for "Book a 10-minute demo". Empty falls back to VITE_DEMO_CALL_URL, then to the demo section.
VITE_BOOK_DEMO_URL=
# Demo practice phone numbers, shown in "Try it yourself". Empty hides that region's number;
# with no numbers and no VITE_DEMO_CALL_URL the box is hidden.
VITE_DEMO_PHONE_AU=
VITE_DEMO_PHONE_UK=

# Legal pages. Empty links are left out of the footer.
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_DPA_URL=

# Set true ONLY once OPENAI_ZDR_ENABLED and DEEPGRAM_ZDR_ENABLED are both true in production
# (vendor-approved Zero Data Retention). Until then the page says calls are never used to train AI.
VITE_CLAIM_ZDR=false
