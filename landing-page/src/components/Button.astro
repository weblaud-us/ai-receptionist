---
/**
 * Link styled as a button (Ordin: 2px corners, label that scrambles on hover, arrow that swaps).
 * With `signup`, the href is the dashboard signup for this page's region and plan;
 * `data-signup-au` / `data-signup-uk` let the region switch swap it without a reload.
 * Colours come from the surrounding band (.tone-dark / .tone-light).
 */
import type { PlanKey } from '../data/plans';
import { regionFromPath } from '../data/regions';
import { signupUrl } from '../data/site';

interface Props {
  href?: string;
  signup?: PlanKey;
  variant?: 'primary' | 'outline' | 'ink';
  size?: 'md' | 'lg';
  class?: string;
  external?: boolean;
  arrow?: boolean;
}
const { href = '#', signup, variant = 'primary', size = 'md', class: className = '', external = false, arrow = true } = Astro.props;
const region = regionFromPath(Astro.url.pathname);
const finalHref = signup ? signupUrl(region, signup) : href;
---
<a
  href={finalHref}
  class:list={['btn', `btn-${variant}`, size === 'lg' && 'btn-lg', className]}
  data-signup-au={signup ? signupUrl('au', signup) : undefined}
  data-signup-uk={signup ? signupUrl('uk', signup) : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <span data-scramble><slot /></span>
  {
    arrow && (
      <span class="btn-arrow" aria-hidden="true">
        <svg viewBox="0 0 11 11" focusable="false"><path d="M2 9 9 2M3.5 2H9v5.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" /></svg>
        <svg viewBox="0 0 11 11" focusable="false"><path d="M2 9 9 2M3.5 2H9v5.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" /></svg>
      </span>
    )
  }
</a>
