---
import { regionFromPath } from '../data/regions';

interface Props {
  class?: string;
  id?: string;
}
const { class: className = '', id = 'region-toggle' } = Astro.props;
const region = regionFromPath(Astro.url.pathname);
const options = [
  { key: 'au', short: 'AU', long: 'Australia, prices in AUD' },
  { key: 'uk', short: 'UK', long: 'United Kingdom, prices in GBP' },
] as const;
---
<div role="group" aria-labelledby={`${id}-label`} class:list={['inline-flex items-center', className]}>
  <span id={`${id}-label`} class="sr-only">Region</span>
  <span class="inline-flex rounded-[2px] border border-[var(--line-strong)] p-[3px]">
    {
      options.map((o) => (
        <button
          type="button"
          data-region-option={o.key}
          aria-pressed={o.key === region}
          aria-label={o.long}
          title={o.long}
          class="h-[34px] min-w-11 rounded-[1px] px-3 font-mono text-[0.75rem] font-medium text-[var(--fg-2)] transition-colors duration-300 hover:text-[var(--fg)] aria-pressed:bg-[var(--fg)] aria-pressed:text-[var(--toggle-on,#fff)]"
        >
          {o.short}
        </button>
      ))
    }
  </span>
</div>
