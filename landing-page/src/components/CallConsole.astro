---
/**
 * The hero's product stage, in the style of Ordin's boot-sequence panel: four numbered steps that
 * light up as the call plays (answered → qualified → booked → synced), a progress readout, the
 * transcript and the diary. console-sequence.ts plays it once after the preloader; with reduced
 * motion or no JavaScript the finished state shows.
 */
import R from './R.astro';
import Wave from './Wave.astro';
import { both, money } from '../data/regions';
import { BRAND } from '../data/site';

const pms = both((_, f) => f.pms.primary);
const dentist = both((_, f) => f.practice.dentist);
const fee = both((r, f) => money(r, f.consultFee));
const value = both((r, f) => `${money(r, f.consoleValue)} ${f.currency}`);
const caller = { au: '0491 570 156', uk: '07700 900 418' }; // ACMA / Ofcom fictional ranges
const steps = [
  { k: 'Answered', v: { au: 'in about a second', uk: 'in about a second' } },
  { k: 'Qualified', v: { au: 'implant enquiry', uk: 'implant enquiry' } },
  { k: 'Booked', v: { au: 'Thu 10:30', uk: 'Thu 10:30' } },
  { k: 'Synced', v: pms },
];
const diary = [
  { time: '10:00', label: 'Hygiene, returning patient', kind: 'booked' },
  { time: '10:30', label: 'Implant consultation, new patient', kind: 'new' },
  { time: '11:00', label: 'Crown fit', kind: 'booked' },
] as const;
---
<div id="hero-stage" class="relative w-full">
  <figure
    id="call-console"
    class="relative overflow-hidden rounded-[2px] border border-[var(--line-strong)] bg-[rgb(10_18_22/0.72)] backdrop-blur-md"
    aria-label={`Example: ${BRAND} answers a lunch-break call and books an implant consultation`}
  >
    <!-- Header -->
    <div class="flex items-center justify-between gap-3 border-b border-[var(--line)] px-[max(1rem,1.3vw)] py-[max(0.75rem,0.85vw)] ord-label">
      <span class="flex items-center gap-2.5 text-[var(--fg)]">
        <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-aqua opacity-50 motion-safe:animate-ping"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-aqua"></span>
        </span>
        Lunch break overflow
      </span>
      <span class="text-[var(--fg-3)] tnum">call_1314 · 1:14 PM</span>
    </div>

    <!-- Boot steps -->
    <ol class="grid grid-cols-2 border-b border-[var(--line)] sm:grid-cols-4" aria-label="What happened on the call">
      {
        steps.map((s, i) => (
          <li
            class:list={[
              'boot-step seq-dim px-[max(1rem,1.1vw)] py-[max(0.75rem,0.9vw)]',
              i % 2 === 1 && 'border-l border-[var(--line)]',
              i === 2 && 'border-t border-[var(--line)] sm:border-l sm:border-t-0',
              i === 3 && 'border-t border-[var(--line)] sm:border-t-0',
            ]}
            data-step={i + 1}
          >
            <span class="flex items-center gap-2 ord-label text-[var(--fg-3)]">
              <span class="boot-dot h-1.5 w-1.5 bg-aqua" aria-hidden="true" />
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="mt-1.5 block text-[0.9375rem] tracking-[-0.01em] text-[var(--fg)]">{s.k}</span>
            <span class="mt-0.5 block ord-label leading-snug text-aqua-light"><R v={s.v} /></span>
          </li>
        ))
      }
    </ol>

    <div class="px-[max(1rem,1.3vw)] pb-[max(1rem,1.2vw)] pt-[max(1rem,1.1vw)]">
      <!-- Caller line -->
      <div class="flex items-center gap-3">
        <div class="min-w-0">
          <p class="ord-label text-[var(--fg-3)]">Caller</p>
          <p class="whitespace-nowrap font-mono text-[0.8125rem] text-[var(--fg)] tnum"><R v={caller} /></p>
        </div>
        <Wave id="console-wave" class="ml-auto h-6 min-w-0 overflow-hidden text-aqua" bars={26} seed={11} />
        <span id="console-timer" class="w-11 shrink-0 text-right font-mono text-[0.75rem] text-[var(--fg-3)] tnum">00:38</span>
      </div>

      <!-- Transcript -->
      <ol class="mt-4 space-y-3 text-[0.875rem] leading-[1.5]" aria-label="Transcript">
        <li class="seq" data-step="1">
          <span class="block ord-label text-[var(--fg-3)]">Patient</span>
          <span class="text-[var(--fg-2)]">Hi, I saw your Google ad for dental implants. How much is a full arch?</span>
        </li>
        <li class="seq border-l border-aqua/60 pl-3" data-step="2">
          <span class="block ord-label text-aqua-light">{BRAND}</span>
          <span class="text-[var(--fg)]">
            I can't price treatment over the phone, but the implant consultation is <R v={fee} /> and includes your full plan. <R v={dentist} /> has
            Thursday at 10:30. Shall I book it?
          </span>
        </li>
      </ol>

      <!-- Diary -->
      <div class="mt-4 border border-[var(--line)]">
        <div class="flex items-baseline justify-between border-b border-[var(--line)] px-3 py-2">
          <span class="text-[0.75rem] text-[var(--fg)]">Thursday, <R v={dentist} /></span>
          <span class="ord-label text-[var(--fg-3)]"><R v={pms} /></span>
        </div>
        <ul class="divide-y divide-[var(--line)]">
          {
            diary.map((row) => (
              <li class="grid grid-cols-[3.25rem_1fr] items-stretch">
                <span class="border-r border-[var(--line)] px-2.5 py-2 font-mono text-[0.6875rem] text-[var(--fg-3)] tnum">{row.time}</span>
                {row.kind === 'new' ? (
                  <span class="relative px-1.5 py-1">
                    <span class="absolute inset-1 border border-dashed border-[var(--line-strong)]" aria-hidden="true" />
                    <span class="slot-fill relative flex h-full items-center bg-aqua px-2.5 text-[0.75rem] font-medium text-night" data-step="3">
                      {row.label}
                    </span>
                  </span>
                ) : (
                  <span class="px-2.5 py-2 text-[0.75rem] text-[var(--fg-3)]">{row.label}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Readout -->
    <div class="flex items-end justify-between gap-4 border-t border-[var(--line)] px-[max(1rem,1.3vw)] py-[max(0.75rem,0.9vw)]">
      <div class="seq" data-step="4">
        <p class="ord-label text-[var(--fg-3)]">Synced · est. value</p>
        <p class="mt-0.5 font-mono text-[0.9375rem] text-aqua-light tnum"><R v={value} /></p>
      </div>
      <div class="w-[42%] text-right" aria-hidden="true">
        <p class="ord-label text-[var(--fg-3)]"><span id="console-progress" class="text-[var(--fg)] tnum">100</span>%</p>
        <div class="mt-1.5 h-px bg-[var(--line-strong)]"><div id="console-bar" class="h-px origin-left bg-aqua"></div></div>
      </div>
    </div>
    <figcaption class="sr-only">
      A caller asks about implant prices during the lunch break. The assistant quotes only the consultation fee, offers Thursday at 10:30, and the
      consultation appears in the practice diary with its estimated value.
    </figcaption>
  </figure>
  <p class="mt-3 ord-label text-[var(--fg-3)] lg:text-right">Sample call. <R v={both((_, f) => `${f.practice.name} is a fictional practice.`)} /></p>
</div>

<script>
  import { initConsole } from '../scripts/console-sequence';
  initConsole();
</script>
