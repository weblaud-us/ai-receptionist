---
/**
 * The hero's product visual: a lunch-break call that ends as a booking in the practice diary.
 * Steps reveal once in order (console-sequence.ts); with reduced motion, the finished state shows.
 */
import R from './R.astro';
import Wave from './Wave.astro';
import { both, money } from '../data/regions';
import { BRAND } from '../data/site';

const pms = both((_, f) => f.pms.primary);
const dentist = both((_, f) => f.practice.dentist);
const fee = both((r, f) => money(r, f.consultFee));
const value = both((r, f) => `${money(r, f.consoleValue)} ${f.currency}`);
const caller = { au: '0491 570 156', uk: '07700 900 418' }; // ACMA / Ofcom fictional ranges
const diary = [
  { time: '10:00', label: 'Hygiene, returning patient', kind: 'booked' },
  { time: '10:30', label: 'Implant consultation, new patient', kind: 'new' },
  { time: '11:00', label: 'Crown fit', kind: 'booked' },
] as const;
---
<figure
  id="call-console"
  class="relative rounded-[var(--radius-console)] border border-hairline bg-surface shadow-[0_1px_2px_rgb(15_23_42/0.04),0_24px_48px_-24px_rgb(15_23_42/0.18)]"
  aria-label={`Example: ${BRAND} answers a lunch-break call and books an implant consultation`}
>
  <!-- Call header -->
  <div class="flex items-center justify-between gap-3 border-b border-hairline px-5 py-3.5">
    <div class="flex items-center gap-2.5">
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full rounded-full bg-teal opacity-40 motion-safe:animate-ping"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-teal"></span>
      </span>
      <span class="text-sm font-medium text-ink">Lunch break overflow</span>
    </div>
    <span class="font-mono text-[0.8125rem] text-slate tnum">1:14 pm</span>
  </div>

  <div class="px-5 pb-5 pt-4">
    <!-- Caller line -->
    <div class="flex items-center gap-3">
      <div class="min-w-0">
        <p class="text-[0.8125rem] text-slate">Caller</p>
        <p class="font-mono text-sm text-ink tnum"><R v={caller} /></p>
      </div>
      <Wave id="console-wave" class="ml-auto h-7 text-teal" bars={26} seed={11} />
      <span id="console-timer" class="w-11 text-right font-mono text-[0.8125rem] text-slate tnum">00:38</span>
    </div>

    <!-- Transcript -->
    <ol class="mt-4 space-y-3 text-[0.9375rem] leading-[1.55]" aria-label="Transcript">
      <li class="seq" data-step="1">
        <span class="block text-[0.75rem] font-medium text-slate">Patient</span>
        <span class="text-ink">Hi, I saw your Google ad for dental implants. How much is a full arch?</span>
      </li>
      <li class="seq rounded-[var(--radius-control)] bg-sage px-3.5 py-3" data-step="2">
        <span class="block text-[0.75rem] font-medium text-teal-deep">{BRAND}</span>
        <span class="text-ink">
          I can't price treatment over the phone, but the implant consultation is <R v={fee} /> and includes your full plan. <R v={dentist} /> has
          Thursday at 10:30. Shall I book it?
        </span>
      </li>
    </ol>

    <!-- Diary -->
    <div class="mt-5 rounded-[var(--radius-panel)] border border-hairline">
      <div class="flex items-baseline justify-between border-b border-hairline px-3.5 py-2">
        <span class="text-[0.8125rem] font-medium text-ink">Thursday, <R v={dentist} /></span>
        <span class="text-[0.75rem] text-slate"><R v={pms} /> diary</span>
      </div>
      <ul class="divide-y divide-hairline">
        {
          diary.map((row) => (
            <li class="grid grid-cols-[3.25rem_1fr] items-stretch">
              <span class="border-r border-hairline px-3 py-2.5 font-mono text-[0.75rem] text-slate tnum">{row.time}</span>
              {row.kind === 'new' ? (
                <span class="relative px-2 py-1.5">
                  <span class="absolute inset-1.5 rounded-md border border-dashed border-hairline-strong" aria-hidden="true" />
                  <span class="slot-fill relative flex h-full items-center rounded-md bg-teal px-2.5 text-[0.8125rem] font-medium text-white" data-step="3">
                    {row.label}
                  </span>
                </span>
              ) : (
                <span class="px-3 py-2.5 text-[0.8125rem] text-slate">{row.label}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Outcome -->
    <div class="seq mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5" data-step="4">
      <span class="inline-flex items-center gap-2 text-sm font-medium text-ink">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="7.25" fill="#0F766E"></circle><path d="M4.75 8.25 7 10.5l4.25-4.75" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        Booked in <R v={pms} />
      </span>
      <span class="text-sm text-slate">Estimated value <span class="font-medium text-champagne-ink tnum"><R v={value} /></span></span>
    </div>
  </div>
  <figcaption class="sr-only">
    A caller asks about implant prices during the lunch break. The assistant quotes only the consultation fee, offers Thursday at 10:30, and the
    consultation appears in the practice diary with its estimated value.
  </figcaption>
</figure>
<p class="mt-3 text-[0.8125rem] text-slate">Sample call. <R v={both((_, f) => `${f.practice.name} is a fictional practice.`)} /></p>

<script>
  import { initConsole } from '../scripts/console-sequence';
  initConsole();
</script>
