---
import Button from './Button.astro';
import CallConsole from './CallConsole.astro';
import R from './R.astro';
import Regional from './Regional.astro';
import { both, money } from '../data/regions';
import { CLAIM_ZDR } from '../data/site';

const headlineValue = both((r, f) => money(r, f.headlineValue));
const accent = { au: 'Australian', uk: 'British' };
const facts = [
  { k: 'About a second', v: both((r) => `to reply, in a natural ${accent[r]} voice`) },
  {
    k: { au: 'Cliniko booking', uk: 'Dentally booking' },
    v: { au: 'straight into the diary; Dentally in early access', uk: 'in early access; Cliniko and Google Calendar today' },
  },
  CLAIM_ZDR
    ? { k: 'Zero data retention', v: { au: 'on AI processing of patient calls', uk: 'on AI processing of patient calls' } }
    : { k: 'No AI training', v: { au: "on your patients' calls, by anyone", uk: "on your patients' calls, by anyone" } },
  { k: 'Text-back in 15 s', v: { au: 'when a caller hangs up before the greeting ends', uk: 'when a caller hangs up before the greeting ends' } },
];
---
<section id="top" data-tone="dark" data-orb="hero" class="tone-dark glow overflow-hidden" aria-labelledby="hero-title">
  <div class="container-page flex min-h-[100svh] flex-col pb-[max(1.5rem,2.4vw)] pt-[max(7rem,9vw)]">
    <div class="grid flex-1 grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-[3vw]">
      <div class="lg:col-span-7">
        <p class="ord-label flex items-center gap-2.5 text-[var(--fg-3)]" data-hero-fade data-hide>
          <span class="h-1.5 w-1.5 bg-aqua" aria-hidden="true"></span>
          <R v={{ au: 'AI overflow receptionist · Australian dental practices', uk: 'AI overflow receptionist · UK dental practices' }} />
        </p>
        <!-- No data-hide (audit FRONT-03): the headline paints at once under the preloader, so it counts
             for LCP; heroIntro() moves its lines to their start position as the preloader lifts. -->
        <h1 id="hero-title" class="display hero-title mt-[max(1.25rem,1.8vw)] text-[var(--fg)]">
          Stop losing <R v={headlineValue} /> implant patients <span class="hl">to voicemail.</span>
        </h1>

        <div data-hero-fade data-hide>
          <Regional as="p" class="lede mt-[max(1.5rem,2vw)] max-w-[46ch]">
            <Fragment slot="au">
              An AI overflow receptionist for private and mixed dental practices in Australia. It answers busy lines, lunch breaks and after-hours
              calls, qualifies implant and cosmetic enquiries, and books consultations straight into Cliniko.
            </Fragment>
            <Fragment slot="uk">
              An AI overflow receptionist for private and mixed dental practices in the UK. It answers busy lines, lunch breaks and after-hours calls,
              qualifies implant and cosmetic enquiries, and books consultations straight into your practice diary.
            </Fragment>
          </Regional>
        </div>

        <div class="mt-[max(2rem,2.6vw)] flex flex-col gap-3 sm:flex-row sm:items-center" data-hero-fade data-hide>
          <Button signup="dental_essentials" size="lg">Start 14-day pilot</Button>
          <Button href="#demo" variant="outline" size="lg">Hear a dental call</Button>
        </div>
      </div>

      <div class="lg:col-span-5" data-hero-fade data-hide>
        <CallConsole />
      </div>
    </div>

    <dl class="mt-[max(3rem,4vw)] grid grid-cols-2 border-t border-[var(--line-strong)] lg:grid-cols-4" data-hero-fade data-hide>
      {
        facts.map((f, i) => (
          <div
            class:list={[
              'py-[max(1rem,1.2vw)] pr-4',
              i % 2 === 1 && 'border-l border-[var(--line)] pl-4 lg:pl-[1.2vw]',
              i >= 2 && 'border-t border-[var(--line)] lg:border-t-0',
              i === 2 && 'lg:border-l lg:pl-[1.2vw]',
            ]}
          >
            <dt class="flex items-baseline gap-3 text-[max(1rem,1.1vw)] tracking-[-0.015em] text-[var(--fg)]">
              <span class="ord-label text-aqua-light" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <R v={typeof f.k === 'string' ? { au: f.k, uk: f.k } : f.k} />
            </dt>
            <dd class="mt-1.5 max-w-[32ch] text-[0.875rem] leading-snug text-[var(--fg-3)]"><R v={f.v} /></dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
