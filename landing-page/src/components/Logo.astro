---
/** Wordmark: two diary slots, the lower one booked. */
import { BRAND } from '../data/site';

interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---
<span class="inline-flex items-center gap-2.5">
  <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false">
    <rect x="1" y="2" width="20" height="7" rx="2" fill="none" stroke={dark ? '#94A3B8' : '#0F172A'} stroke-opacity={dark ? 0.7 : 0.35} stroke-width="1.5"></rect>
    <rect x="1" y="12" width="20" height="8" rx="2" fill={dark ? '#5FB8AE' : '#0F766E'}></rect>
  </svg>
  <span class:list={['font-display text-[1.375rem] leading-none tracking-[-0.01em]', dark ? 'text-mist' : 'text-ink']}>{BRAND}</span>
</span>
