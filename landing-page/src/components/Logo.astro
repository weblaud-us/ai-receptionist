---
/** The LaudLine wordmark (src/assets/laudline.svg, from brand/laudline.svg). Takes its colour from its band. */
import Wordmark from '../assets/laudline.svg';
import { BRAND } from '../data/site';
---
<span class="inline-flex items-center text-[var(--fg)]">
  <Wordmark class="h-[max(1.35rem,1.5vw)] w-auto" aria-hidden="true" focusable="false" />
  <span class="sr-only">{BRAND}</span>
</span>
