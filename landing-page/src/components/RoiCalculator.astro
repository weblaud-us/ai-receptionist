---
import Button from './Button.astro';
import R from './R.astro';
import { ESSENTIALS } from '../data/plans';
import { REGION, money, regionFromPath, type Region } from '../data/regions';
import { BRAND } from '../data/site';

const region = regionFromPath(Astro.url.pathname);

/** Calculator settings per region; read by roi.ts. */
const config = {
  au: { locale: REGION.au.locale, currency: REGION.au.currency, plan: ESSENTIALS.monthly.au, value: { min: 1000, max: 15000, step: 250, def: 3500 } },
  uk: { locale: REGION.uk.locale, currency: REGION.uk.currency, plan: ESSENTIALS.monthly.uk, value: { min: 600, max: 10000, step: 100, def: 2500 } },
} satisfies Record<Region, unknown>;

const CAPTURE = 0.6;
const WEEKS_PER_MONTH = 4.33;
const D = { calls: 12, hv: 20, close: 35 };
const v = config[region].value;
const leak = D.calls * WEEKS_PER_MONTH * (D.hv / 100) * (D.close / 100) * v.def;
const recovered = leak * CAPTURE;
const multiple = recovered / config[region].plan;
const fill = (val: number, min: number, max: number) => `--fill:${(((val - min) / (max - min)) * 100).toFixed(1)}%`;

const sliders = [
  { id: 'calls', label: 'Missed calls a week', hint: 'Lunch breaks, busy lines and after hours', min: 3, max: 40, step: 1, value: D.calls, text: `${D.calls}` },
  { id: 'hv', label: 'High-value enquiries', hint: 'Share that are implant, Invisalign or cosmetic', min: 5, max: 60, step: 5, value: D.hv, text: `${D.hv}%` },
  { id: 'value', label: 'Average treatment value', hint: 'What an accepted case is worth', min: v.min, max: v.max, step: v.step, value: v.def, text: money(region, v.def) },
  { id: 'close', label: 'Consultations that go ahead', hint: 'Your consult-to-treatment rate', min: 10, max: 70, step: 5, value: D.close, text: `${D.close}%` },
];
---
<section id="roi" class="section border-t border-hairline" aria-labelledby="roi-title">
  <div class="container-page">
    <div class="max-w-3xl">
      <h2 id="roi-title" class="h2 text-ink">What missed calls cost your practice</h2>
      <p class="lede mt-4">Move the sliders to match your practice. Everything is worked out in your browser; nothing is sent anywhere.</p>
    </div>

    <form
      id="roi-form"
      class="mt-14 grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16"
      data-config={JSON.stringify(config)}
      data-capture={CAPTURE}
      data-weeks={WEEKS_PER_MONTH}
      data-page-region={region}
    >
      <fieldset class="space-y-9 lg:col-span-7">
        <legend class="sr-only">Your practice</legend>
        {
          sliders.map((s) => (
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <label for={`roi-${s.id}`} class="font-medium text-ink">
                  {s.label}
                </label>
                <output id={`roi-${s.id}-out`} for={`roi-${s.id}`} class="font-mono text-[1.0625rem] text-ink tnum">
                  {s.text}
                </output>
              </div>
              <p id={`roi-${s.id}-hint`} class="mt-0.5 text-sm text-slate">
                {s.hint}
              </p>
              <input
                id={`roi-${s.id}`}
                name={s.id}
                type="range"
                class="range mt-3"
                min={s.min}
                max={s.max}
                step={s.step}
                value={s.value}
                aria-describedby={`roi-${s.id}-hint`}
                aria-valuetext={s.text}
                style={fill(s.value, s.min, s.max)}
              />
            </div>
          ))
        }
      </fieldset>

      <div class="lg:col-span-5">
        <div class="rounded-[var(--radius-panel)] border border-hairline bg-sage p-6 sm:p-8">
          <p id="roi-summary" class="sr-only" role="status" aria-live="polite"></p>
          <dl class="space-y-7">
            <div>
              <dt class="text-[0.9375rem] text-slate">Leaking to voicemail each month</dt>
              <dd class="mt-1 font-display text-[2.5rem] leading-none text-ink tnum" id="roi-leak">{money(region, Math.round(leak))}</dd>
            </div>
            <div class="border-t border-hairline-strong pt-6">
              <dt class="text-[0.9375rem] text-slate">Recovered each month with {BRAND}</dt>
              <dd class="mt-1 font-display text-[2.5rem] leading-none text-teal-deep tnum" id="roi-recovered">{money(region, Math.round(recovered))}</dd>
              <dd class="mt-2 text-sm text-slate">If it captures 60% of those calls</dd>
            </div>
            <div class="border-t border-hairline-strong pt-6">
              <dt class="text-[0.9375rem] text-slate">Return on Dental Essentials</dt>
              <dd class="mt-1 font-display text-[2.5rem] leading-none text-ink tnum" id="roi-multiple">{Math.round(multiple)}×</dd>
              <dd class="mt-2 text-sm text-slate" id="roi-payback">One accepted case covers {Math.floor(v.def / config[region].plan)} months of the plan.</dd>
            </div>
          </dl>
          <Button signup="dental_essentials" size="lg" class="mt-8 w-full">Start your 14-day pilot</Button>
        </div>
        <p class="mt-4 text-[0.8125rem] leading-relaxed text-slate">
          An estimate, not a promise. It assumes 4.33 weeks a month and compares recovered revenue with Dental Essentials at <R
            v={{ au: `${money('au', ESSENTIALS.monthly.au)} a month, excluding GST`, uk: `${money('uk', ESSENTIALS.monthly.uk)} a month, excluding VAT` }}
          />.
        </p>
      </div>
    </form>
  </div>
</section>

<script>
  import { initRoi } from '../scripts/roi';
  initRoi();
</script>
