---
/**
 * Privacy and hosting: a numbered five-step data flow that lights up on scroll, then the region's legal frame and the
 * protections shared by both regions. Claims track the backend: ZDR only when VITE_CLAIM_ZDR is on,
 * encryption described as it is implemented (Fernet: AES with an HMAC), never "HIPAA".
 */
import R from './R.astro';
import Regional from './Regional.astro';
import SectionRule from './SectionRule.astro';
import { both } from '../data/regions';
import { CLAIM_ZDR, LINKS } from '../data/site';

const city = both((_, f) => f.hosting.city);
const awsRegion = both((_, f) => f.hosting.region);

const flow = [
  { title: 'Patient call', sub: { au: 'forwarded number', uk: 'forwarded number' } },
  { title: both((_, f) => `Hosted in ${f.hosting.city}`), sub: awsRegion },
  { title: { au: CLAIM_ZDR ? 'Zero-retention LLM' : 'LLM, training off', uk: CLAIM_ZDR ? 'Zero-retention LLM' : 'LLM, training off' }, sub: { au: 'no model training', uk: 'no model training' } },
  { title: { au: 'Encrypted clinical text', uk: 'Encrypted clinical text' }, sub: { au: 'field-level, AES + HMAC', uk: 'field-level, AES + HMAC' } },
  { title: { au: 'Auto-purge', uk: 'Auto-purge' }, sub: { au: '30, 60 or 90 days', uk: '30, 60 or 90 days' } },
] as const;

// One line icon per step (24×24, stroked): phone, map pin, no-training, lock, timer.
const ICONS = [
  '<path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  '<path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  '<path d="M12 3.5l1.7 4.3 4.3 1.7-4.3 1.7L12 15.5l-1.7-4.3L6 9.5l4.3-1.7z"/><path d="M4 20 20 4"/>',
  '<rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><path d="M12 15v2"/>',
  '<circle cx="12" cy="13.5" r="7"/><path d="M12 10v3.5l2.5 2M10 3h4"/>',
];

const shared = [
  {
    title: CLAIM_ZDR ? 'Zero data retention on AI processing' : 'Never used to train AI',
    body: CLAIM_ZDR
      ? 'Language and speech providers process calls under zero-data-retention terms and never train on them.'
      : 'Speech and language providers run with storage for training switched off. Your patients’ calls never train anyone’s models.',
  },
  {
    title: 'Clinical notes encrypted',
    body: 'Transcripts and the symptoms and notes taken from patients are encrypted field by field at rest, readable only by your authorised staff.',
  },
  {
    title: 'No call recordings',
    body: 'Calls are never recorded, only transcribed. Transcripts are deleted after 90 days by default; choose 30, 60 or 90 days.',
  },
  {
    title: 'Access and erasure requests',
    body: 'Find everything held about a patient and export or erase it, including transcripts and captured leads.',
  },
];
---
<section id="compliance" data-tone="dark" data-orb="guard" data-hold class="tone-dark glow" aria-labelledby="compliance-title">
  <div data-pin>
  <div class="container-page section-pad">
    <SectionRule idx="03" label="Privacy and hosting">Built to local law</SectionRule>
    <div class="mt-[max(2rem,3vw)] grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="compliance-title" class="h2">Patient privacy, handled like clinical data. <span class="hl">Hosted in <R v={city} />.</span></h2>
        <p class="lede mt-[max(1.25rem,1.6vw)]">
          Calls about teeth are health information. It's built to the privacy law your practice answers to, not to a US standard.
        </p>
      </div>

      <figure class="glass p-[max(1.25rem,1.8vw)] lg:col-span-7">
        <p class="ord-label mb-2 flex items-center justify-between gap-4 text-[var(--fg-2)]">
          <span>How a call's data moves</span>
          <span class="text-[var(--fg-3)]">01 → 05</span>
        </p>
        <ol class="flow-list" aria-label="How a call's data moves" data-steps>
          {
            flow.map((n, i) => (
              <li class="ord-step flow-step" data-scene-item>
                <span class="flow-node" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[i]} />
                </span>
                <span class="flex min-w-0 items-baseline gap-3">
                  <span class="ord-num ord-label text-[var(--fg-3)]">{String(i + 1).padStart(2, '0')}</span>
                  <span class="t-30 text-[var(--fg)]"><R v={typeof n.title === 'string' ? { au: n.title, uk: n.title } : n.title} /></span>
                </span>
                <span class="flow-chip"><R v={n.sub} /></span>
              </li>
            ))
          }
        </ol>
        <figcaption class="mt-4 border-t border-[var(--line)] pt-4 text-[0.875rem] leading-relaxed text-[var(--fg-2)]">
          Database, transcripts and servers stay in AWS <R v={city} />. Speech and language models run where each provider hosts them.
        </figcaption>
      </figure>
    </div>

    <div class="mt-[max(3rem,5vw)] grid grid-cols-1 items-start gap-5 lg:grid-cols-12">
      <Regional class="card p-[max(1.5rem,2vw)] lg:col-span-7">
        <Fragment slot="au">
          <div class="flex items-center justify-between gap-4">
            <h3 class="h3">For Australian practices</h3>
            <span class="chip">ap-southeast-2</span>
          </div>
          <dl class="mt-6 grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
            <div class="border-t border-[var(--line)] pt-4">
              <dt class="text-[var(--fg)]">Australian Privacy Principles</dt>
              <dd class="mt-1.5 text-[0.9375rem] text-[var(--fg-2)]">Built to the Privacy Act 1988 and the APPs, including APP 8 on overseas disclosure and the Notifiable Data Breaches scheme.</dd>
            </div>
            <div class="border-t border-[var(--line)] pt-4">
              <dt class="text-[var(--fg)]">Hosted in Sydney</dt>
              <dd class="mt-1.5 text-[0.9375rem] text-[var(--fg-2)]">Database, transcripts and servers in AWS Sydney. Speech and language models run where each provider hosts them.</dd>
            </div>
            <div class="border-t border-[var(--line)] pt-4">
              <dt class="text-[var(--fg)]">Recall messages under the Spam Act</dt>
              <dd class="mt-1.5 text-[0.9375rem] text-[var(--fg-2)]">Spam Act 2003 rules on every recall message: consent recorded, the practice named, STOP honoured. DNCR checks before any voice recall.</dd>
            </div>
            <div class="border-t border-[var(--line)] pt-4">
              <dt class="text-[var(--fg)]">Transcription announced</dt>
              <dd class="mt-1.5 text-[0.9375rem] text-[var(--fg-2)]">Callers hear that the call is transcribed before anything else, and the assistant always says it is an AI.</dd>
            </div>
          </dl>
        </Fragment>
        <Fragment slot="uk">
          <div class="flex items-center justify-between gap-4">
            <h3 class="h3">For UK practices</h3>
            <span class="chip">eu-west-2</span>
          </div>
          <dl class="mt-6 grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
            <div class="border-t border-[var(--line)] pt-4">
              <dt class="text-[var(--fg)]">UK GDPR Article 9</dt>
              <dd class="mt-1.5 text-[0.9375rem] text-[var(--fg-2)]">Health data treated as special category data, processed under Article 9(2)(h) and an ICO-aligned data processing agreement.</dd>
            </div>
            <div class="border-t border-[var(--line)] pt-4">
              <dt class="text-[var(--fg)]">Hosted in London</dt>
              <dd class="mt-1.5 text-[0.9375rem] text-[var(--fg-2)]">Database, transcripts and servers in AWS London. Speech and language models run where each provider hosts them.</dd>
            </div>
            <div class="border-t border-[var(--line)] pt-4">
              <dt class="text-[var(--fg)]">Recall messages under PECR</dt>
              <dd class="mt-1.5 text-[0.9375rem] text-[var(--fg-2)]">The soft opt-in for existing patients, the consent basis logged on every message, and opt-outs honoured. TPS screening before any voice recall.</dd>
            </div>
            <div class="border-t border-[var(--line)] pt-4">
              <dt class="text-[var(--fg)]">Transcription announced</dt>
              <dd class="mt-1.5 text-[0.9375rem] text-[var(--fg-2)]">Callers hear that the call is transcribed before anything else, and the assistant always says it is an AI.</dd>
            </div>
          </dl>
        </Fragment>
      </Regional>

      <div class="card p-[max(1.5rem,2vw)] lg:col-span-5">
        <h3 class="h3">In both regions</h3>
        <dl class="mt-6 space-y-5">
          {
            shared.map((item) => (
              <div class="border-t border-[var(--line)] pt-4">
                <dt class="text-[var(--fg)]">{item.title}</dt>
                <dd class="mt-1.5 text-[0.9375rem] text-[var(--fg-2)]">{item.body}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-6 border-t border-[var(--line)] pt-4 text-[0.875rem] text-[var(--fg-2)]">
          The practice is the data controller; we act as your processor under a data processing agreement.
          {LINKS.dpa && <a href={LINKS.dpa} class="text-aqua-light underline underline-offset-4">Read the DPA</a>}
        </p>
      </div>
    </div>
  </div>
  </div>
</section>
