---
import Button from './Button.astro';
import { LINKS } from '../data/site';
---
<section class="border-t border-hairline bg-surface" aria-labelledby="cta-title">
  <div class="container-page grid grid-cols-1 gap-10 py-20 lg:grid-cols-12 lg:items-end lg:py-28">
    <div class="lg:col-span-7">
      <h2 id="cta-title" class="text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.05] text-ink">Let lunchtime and evenings book consultations too.</h2>
      <p class="lede mt-5">Forwarding on your existing number, live within days of sign-up. Your team keeps the front desk.</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
      <Button signup="dental_essentials" size="lg">Start 14-day pilot</Button>
      {
        LINKS.bookDemo ? (
          <Button href={LINKS.bookDemo} variant="secondary" size="lg" external>
            Book a 10-minute demo
          </Button>
        ) : (
          <Button href="#demo" variant="secondary" size="lg">
            Hear a dental call
          </Button>
        )
      }
    </div>
  </div>
</section>
