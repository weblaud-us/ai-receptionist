---
/** Closing band (Ordin: tall, centred, one very large line over the orb). */
import Button from './Button.astro';
import R from './R.astro';
import { both } from '../data/regions';
import { LINKS } from '../data/site';

const pms = both((_, f) => f.pms.primary);
---
<section data-tone="dark" data-orb="cta" class="tone-dark glow overflow-hidden" aria-labelledby="cta-title">
  <div class="container-page flex min-h-[max(40rem,110vh)] flex-col items-center justify-center gap-[max(2rem,3vw)] py-[max(6rem,9vw)] text-center">
    <p class="ord-label text-[var(--fg-3)]"><span class="text-aqua-light">(09)</span>&ensp;Start the pilot</p>
    <h2 id="cta-title" class="display mx-auto max-w-[13ch]">Let lunchtime book consultations. <span class="hl">Evenings too.</span></h2>
    <p class="lede mx-auto max-w-[48ch] text-center" data-reveal>
      Forwarding on your existing number, live within days of sign-up. Bookings land in <R v={pms} />, and your team keeps the front desk.
    </p>
    <div class="flex flex-col justify-center gap-3 sm:flex-row" data-reveal>
      <Button signup="dental_essentials" size="lg">Start 14-day pilot</Button>
      {
        LINKS.bookDemo ? (
          <Button href={LINKS.bookDemo} variant="outline" size="lg" external>
            Book a 10-minute demo
          </Button>
        ) : (
          <Button href="#demo" variant="outline" size="lg">
            Hear a dental call
          </Button>
        )
      }
    </div>
  </div>
</section>
