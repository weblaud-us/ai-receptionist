---
/**
 * "Built around real clinic hours": a 24-hour strip (desktop) / stepped list (mobile) of how the
 * assistant works alongside reception through a split-shift day.
 */
const DAY_START = 7; // the strip runs 07:00 → 07:00 next day
const pct = (h: number) => (((h - DAY_START + 24) % 24) / 24) * 100;

const phases = [
  {
    from: '09:00',
    to: '12:50',
    start: 9,
    end: 12 + 50 / 60,
    title: 'Busy overflow',
    body: 'Your team answers. Calls forward only when every line is busy or nobody picks up after four rings.',
    tone: 'overflow',
  },
  {
    from: '12:50',
    to: '13:50',
    start: 12 + 50 / 60,
    end: 13 + 50 / 60,
    title: 'Lunch break cover',
    body: 'Forwarding switches on for the hour. Callers hear a lunch greeting, and lunch slots stay out of the diary.',
    tone: 'lunch',
  },
  {
    from: '13:50',
    to: '17:30',
    start: 13 + 50 / 60,
    end: 17.5,
    title: 'Busy overflow',
    body: 'Back to overflow only. Reception keeps the phones; the assistant catches what they can’t.',
    tone: 'overflow',
  },
  {
    from: '17:30',
    to: '09:00',
    start: 17.5,
    end: 9 + 24,
    title: 'After hours and weekends',
    body: 'Every call answered, consults booked, emergencies directed, and a text sent to anyone who hangs up.',
    tone: 'after',
  },
] as const;

const toneClass = {
  overflow: 'bg-teal-wash',
  lunch: 'bg-champagne/35',
  after: 'bg-teal',
};
const ticks = [9, 12, 15, 18, 21, 0, 3, 6];
---
<section id="how-it-works" class="section" aria-labelledby="day-title">
  <div class="container-page">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      <h2 id="day-title" class="h2 text-ink lg:col-span-5">Built around real clinic hours</h2>
      <p class="lede lg:col-span-6 lg:col-start-7 lg:pt-2">
        It works alongside your receptionists, not instead of them. Set your hours and lunch break once; the greeting and the forwarding follow
        the clock.
      </p>
    </div>

    <!-- Desktop: 24-hour strip -->
    <div class="mt-16 hidden md:block" aria-hidden="true">
      <div class="relative h-14 overflow-hidden rounded-[var(--radius-panel)] border border-hairline bg-surface">
        {
          phases.map((p) => {
            const left = pct(p.start);
            const width = ((p.end - p.start) / 24) * 100;
            return <span class:list={['absolute inset-y-0', toneClass[p.tone]]} style={`left:${left}%;width:${width}%`} />;
          })
        }
        <span class="absolute inset-y-0 left-0 bg-teal" style={`width:${pct(9)}%`}></span>
      </div>
      <div class="relative mt-2 h-5">
        {
          ticks.map((h) => (
            <span class="absolute -translate-x-1/2 font-mono text-[0.75rem] text-slate tnum" style={`left:${pct(h)}%`}>
              {String(h).padStart(2, '0')}:00
            </span>
          ))
        }
      </div>
    </div>

    <ol class="mt-10 grid grid-cols-1 gap-0 md:mt-12 md:grid-cols-4 md:gap-8">
      {
        phases.map((p, i) => (
          <li class="relative border-l border-hairline-strong pb-10 pl-6 last:pb-0 md:border-l-0 md:border-t md:pb-0 md:pl-0 md:pt-6">
            <span
              class:list={['absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full md:-top-[5px] md:left-0', toneClass[p.tone], p.tone !== 'after' && 'ring-1 ring-hairline-strong']}
              aria-hidden="true"
            />
            <p class="font-mono text-sm text-slate tnum">
              <span class="sr-only">Step {i + 1}: </span>
              {p.from}–{p.to}
            </p>
            <h3 class="mt-2 text-lg text-ink">{p.title}</h3>
            <p class="mt-2 text-[0.9375rem] text-slate">{p.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-10 max-w-[64ch] text-sm text-slate">
      Times shown are an example split shift. You set your own hours, including half-day Fridays and Saturday sessions.
    </p>
  </div>
</section>
