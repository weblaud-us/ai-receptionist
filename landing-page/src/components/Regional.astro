---
/** Block-level regional content: pass `slot="au"` and `slot="uk"` children. */
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  class?: string;
}
const { as: Tag = 'div', class: className = '' } = Astro.props;
---
<Tag class:list={['r-au', className]}><slot name="au" /></Tag>
<Tag class:list={['r-uk', className]}><slot name="uk" /></Tag>
