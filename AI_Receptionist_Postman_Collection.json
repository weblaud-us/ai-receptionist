          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guest_name\": \"Ruhul Amin\",\n  \"guest_phone\": \"{{phone}}\",\n  \"guest_email\": \"guest@example.com\",\n  \"room_id\": \"{{room_id}}\",\n  \"check_in_date\": \"2026-05-01\",\n  \"check_out_date\": \"2026-05-03\",\n  \"adults\": 2,\n  \"children\": 0,\n  \"special_requests\": \"Late check-in\"\n}"
            },
            "url": "{{base_url}}/bookings/"
          }
        },
        {
          "name": "Update Booking Status",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/bookings/{{booking_id}}/status?status=confirmed"
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/bookings/{{booking_id}}?reason=Guest%20requested"
          }
        }
      ]
